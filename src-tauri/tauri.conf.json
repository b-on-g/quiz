{
	"$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
	"productName": "Quiz App",
	"version": "0.1.0",
	"identifier": "com.bogquiz.app",
	"build": {
		"frontendDist": "../-",
		"devUrl": "http://localhost:9080/bog/quiz/",
		"beforeDevCommand": "",
		"beforeBuildCommand": ""
	},
	"app": {
		"windows": [
			{
				"title": "Quiz App",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"center": true
			}
		],
		"security": {
			"csp": null
		},
		"withGlobalTauri": true
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
