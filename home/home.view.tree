$bog_quiz_home $mol_page
	title @ \Quiz App
	body /
		<= Welcome $mol_view
			sub /
				<= Title $mol_text
					text @ \Welcome to Quiz App
				<= Description $mol_text
					text @ \Create and play interactive quizzes
				<= Actions $mol_row
					sub /
						<= Create_quiz $mol_button_major
							title @ \Create Quiz
							click?event <=> create?event null
						<= My_quizzes $mol_button_minor
							title @ \My Quizzes
							click?event <=> quizzes?event null
