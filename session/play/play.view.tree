$bog_quiz_session_play $mol_page
	session_id \
	title <= session_title \
	body /
		<= State_view $mol_switch
			value <= state \
			options *
				waiting <= Waiting_view $mol_view
					sub /
						<= Waiting_text $mol_text
							text @ \Waiting for quiz to start...
				question <= Question_view $mol_view
					sub /
						<= Question_text $mol_text
							text <= question_text \
						<= Timer_text $mol_text
							text <= timer_text \
						<= Options_list $mol_list
							rows <= option_rows /
						<= Submit_button $mol_button_major
							click?event <=> submit_answer?event null
							title @ \Submit Answer
							enabled <= can_submit false
				review <= Review_view $mol_view
					sub /
						<= Review_text $mol_text
							text @ \Reviewing answers...
						<= Your_answer $mol_text
							text <= your_answer_text \
						<= Correct_answer $mol_text
							text <= correct_answer_text \
						<= Score_text $mol_text
							text <= score_text \
				finished <= Finished_view $mol_view
					sub /
						<= Finished_text $mol_text
							text @ \Quiz finished!
						<= Final_score $mol_text
							text <= final_score_text \
						<= Leaderboard_section $mol_section
							title @ \Leaderboard
							content /
								<= Leaderboard $mol_list
									rows <= leaderboard_rows /
	
	Option_button* $mol_button
		click?event <=> option_toggle*?event null
		title <= option_text* \
		style * background <= option_background* \
	
	Leaderboard_item* $mol_view
		sub /
			<= Leaderboard_text* $mol_text
				text <= leaderboard_item_text* \
